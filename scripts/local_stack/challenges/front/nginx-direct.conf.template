# firewall-IA local stack — DIRECT-arm TLS / HTTP/2 FRONT (nginx). Rendered by challenge_stack.py.
#
# Same shared TLS/HTTP-2 front as the firewall arms (same image, same ciphers, same ALPN, same body
# re-framing and header normalisation), but it proxies straight to the application container on the
# internal Docker bridge. NO gateway, NO WAF. This is the "aplicación directa" comparator arm: it
# establishes the application's own behaviour and the latency/transport floor, with every other layer
# removed and the client-facing surface held identical to the firewall arms.
#
# The upstream is the application's address on the internal network. The front runs on the host network,
# which can reach that address; the application still has no route out.

worker_processes ${WORKERS};
pid /tmp/nginx.pid;
error_log /logs/front-error.log warn;

events {
    worker_connections 1024;
}

http {
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    server_tokens off;
    default_type application/octet-stream;

    # No target, query, header value or body: only what attributes the answer to a layer.
    log_format fwlab escape=json '{"utc":$msec,"connection":$connection,'
        '"connection_requests":$connection_requests,"protocol":"$server_protocol",'
        '"tls_protocol":"$ssl_protocol","tls_reused":"$ssl_session_reused","method":"$request_method",'
        '"status":$status,"upstream_status":"$upstream_status","upstream_addr":"$upstream_addr",'
        '"request_length":$request_length,"bytes_sent":$bytes_sent,"request_time":$request_time,'
        '"upstream_connect_time":"$upstream_connect_time",'
        '"upstream_response_time":"$upstream_response_time"}';
    access_log /logs/front-access.jsonl fwlab;

    upstream fwlab_app {
        server ${UPSTREAM} max_fails=0;
        keepalive ${UPSTREAM_KEEPALIVE};
    }

    server {
        listen 127.0.0.1:${TLS_PORT} ssl;
        http2 ${HTTP2};
        server_name ${SERVER_NAME};

        ssl_certificate /pki/server.crt;
        ssl_certificate_key /pki/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:fwlab:1m;
        ssl_session_timeout 5m;
        ssl_session_tickets on;

        client_max_body_size ${MAX_BODY};
        client_body_buffer_size ${MAX_BODY};
        large_client_header_buffers 4 16k;
        keepalive_timeout 60s;

        location / {
            proxy_pass http://fwlab_app;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header Connection "";
            proxy_request_buffering on;
            proxy_buffering on;
            proxy_redirect off;
            proxy_intercept_errors off;
            proxy_next_upstream off;
            proxy_connect_timeout 2s;
            proxy_send_timeout ${UPSTREAM_TIMEOUT};
            proxy_read_timeout ${UPSTREAM_TIMEOUT};
        }
    }

    # Readiness of the front itself, on its own loopback port.
    server {
        listen 127.0.0.1:${STATUS_PORT};
        access_log off;
        location = /__front/ready {
            default_type text/plain;
            return 200 "ready\n";
        }
        location / {
            return 404;
        }
    }
}
