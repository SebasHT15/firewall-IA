{
  "schema": "v5-template-catalog/v1",
  "status": "RATIFIED (D75, 2026-10-25): pilot-tested structural catalogue for the V5 research dataset",
  "note": "Structure only. Field names come from field_names_v1.json and are drawn per pair; they are not part of template_id. Every attackable slot's benign pools are drawn independently of its field name (spec §2.1). One carrier per template: its attackable slots all live in that carrier; other locations hold only typed scalars.",
  "templates": [
    {"name": "path-static-a", "cluster": "path-static", "carrier": "path", "method": "GET",
     "path": ["static", "assets", {"type": "path_file"}]},
    {"name": "path-static-b", "cluster": "path-static", "carrier": "path", "method": "GET",
     "path": ["static", "v", {"type": "int"}, "assets", {"type": "path_file"}]},
    {"name": "path-docs-a", "cluster": "path-docs", "carrier": "path", "method": "GET",
     "path": ["docs", "download", {"type": "path_file"}]},
    {"name": "path-people-a", "cluster": "path-people", "carrier": "path", "method": "GET",
     "path": ["people", {"type": "free_string", "pools": ["names_given", "symbols"]}, "profile"]},
    {"name": "path-people-b", "cluster": "path-people", "carrier": "path", "method": "DELETE",
     "path": ["people", {"type": "free_string", "pools": ["names_given", "symbols"]}, "sessions", {"type": "token"}]},
    {"name": "path-wiki-a", "cluster": "path-wiki", "carrier": "path", "method": "GET",
     "path": ["wiki", "page", {"type": "free_string", "pools": ["names_given", "streets", "symbols"]}]},
    {"name": "path-media-a", "cluster": "path-media", "carrier": "path", "method": "GET",
     "path": ["media", {"type": "int"}, "files", {"type": "path_file"}]},
    {"name": "path-tags-a", "cluster": "path-tags", "carrier": "path", "method": "GET",
     "path": ["blog", "tags", {"type": "free_string", "pools": ["names_given", "symbols", "streets"]}, "posts"]},
    {"name": "path-export-a", "cluster": "path-export", "carrier": "path", "method": "GET",
     "path": ["reports", "export", {"type": "token"}, {"type": "path_file"}]},

    {"name": "q-search-a", "cluster": "q-search", "carrier": "query", "method": "GET", "path": ["search"],
     "fields": [{"type": "free_string", "names": "text"}, {"type": "int", "names": "int"}]},
    {"name": "q-search-b", "cluster": "q-search", "carrier": "query", "method": "GET", "path": ["search"],
     "fields": [{"type": "free_string", "names": "text"}, {"type": "int", "names": "int"},
                {"type": "enum", "names": "enum", "choices": ["asc", "desc"]}]},
    {"name": "q-catalog-a", "cluster": "q-catalog", "carrier": "query", "method": "GET", "path": ["shop", "products"],
     "fields": [{"type": "enum", "names": "enum", "choices": ["books", "garden", "toys", "tools"]},
                {"type": "free_string", "names": "text"}, {"type": "int", "names": "int"}, {"type": "int", "names": "int"}]},
    {"name": "q-share-a", "cluster": "q-share", "carrier": "query", "method": "GET", "path": ["share", "preview"],
     "fields": [{"type": "url", "names": "url"}, {"type": "free_string", "names": "text"}]},
    {"name": "q-login-a", "cluster": "q-login", "carrier": "query", "method": "GET", "path": ["account", "login"],
     "fields": [{"type": "url", "names": "url"}]},
    {"name": "q-files-a", "cluster": "q-files", "carrier": "query", "method": "GET", "path": ["files", "view"],
     "fields": [{"type": "path_file", "names": "path"}, {"type": "enum", "names": "enum", "choices": ["en", "es", "fr", "de"]}]},
    {"name": "q-geo-a", "cluster": "q-geo", "carrier": "query", "method": "GET", "path": ["maps", "lookup"],
     "fields": [{"type": "free_string", "names": "text"}, {"type": "number", "names": "number"}, {"type": "number", "names": "number"}]},
    {"name": "q-events-a", "cluster": "q-events", "carrier": "query", "method": "GET", "path": ["events", "calendar", {"type": "int"}],
     "fields": [{"type": "free_string", "names": "text"}, {"type": "int", "names": "int"}, {"type": "int", "names": "int"},
                {"type": "enum", "names": "enum", "choices": ["ics", "csv", "json"]}]},
    {"name": "q-feed-a", "cluster": "q-feed", "carrier": "query", "method": "GET", "path": ["feeds", "import"],
     "fields": [{"type": "url", "names": "url"}, {"type": "enum", "names": "enum", "choices": ["rss", "atom"]}, {"type": "bool", "names": "bool"}]},

    {"name": "f-contact-a", "cluster": "f-contact", "carrier": "form", "method": "POST", "path": ["contact"],
     "fields": [{"type": "free_string", "names": "text"}, {"type": "free_string", "names": "text"}, {"type": "free_string", "names": "text"}]},
    {"name": "f-signup-a", "cluster": "f-signup", "carrier": "form", "method": "POST", "path": ["account", "register"],
     "fields": [{"type": "free_string", "names": "text"}, {"type": "bool", "names": "bool"}, {"type": "free_string", "names": "text"},
                {"type": "free_string", "names": "text"}]},
    {"name": "f-address-a", "cluster": "f-address", "carrier": "form", "method": "POST", "path": ["checkout", "shipping"],
     "fields": [{"type": "free_string", "names": "text"}, {"type": "free_string", "names": "text"}, {"type": "free_string", "names": "text"},
                {"type": "int", "names": "int"}, {"type": "enum", "names": "enum", "choices": ["CR", "US", "DE", "FR", "JP"]}]},
    {"name": "f-comment-a", "cluster": "f-comment", "carrier": "form", "method": "POST", "path": ["blog", "posts", {"type": "int"}, "comments"],
     "fields": [{"type": "free_string", "names": "text"}, {"type": "free_string", "names": "text"}]},
    {"name": "f-webhook-a", "cluster": "f-webhook", "carrier": "form", "method": "POST", "path": ["settings", "integrations"],
     "fields": [{"type": "url", "names": "url"}, {"type": "free_string", "names": "text"}, {"type": "bool", "names": "bool"}]},
    {"name": "f-import-a", "cluster": "f-import", "carrier": "form", "method": "POST", "path": ["library", "import"],
     "fields": [{"type": "path_file", "names": "path"}, {"type": "free_string", "names": "text"}]},
    {"name": "f-login-a", "cluster": "f-login", "carrier": "form", "method": "POST", "path": ["session"],
     "fields": [{"type": "free_string", "names": "text"}, {"type": "free_string", "names": "text"}, {"type": "bool", "names": "bool"},
                {"type": "url", "names": "url"}]},
    {"name": "f-login-b", "cluster": "f-login", "carrier": "form", "method": "POST", "path": ["session"],
     "fields": [{"type": "free_string", "names": "text"}, {"type": "free_string", "names": "text"}, {"type": "bool", "names": "bool"}]},

    {"name": "j-profile-a", "cluster": "j-profile", "carrier": "json", "method": "PATCH", "path": ["api", "v2", "profile"],
     "json": {"object": [{"type": "json_leaf", "names": "text"}, {"type": "json_leaf", "names": "text"},
                         {"names": "object", "object": [{"type": "json_leaf", "names": "text"}, {"type": "json_leaf", "names": "text"}]}]}},
    {"name": "j-profile-b", "cluster": "j-profile", "carrier": "json", "method": "PATCH", "path": ["api", "v2", "profile"],
     "json": {"object": [{"type": "json_leaf", "names": "text"}, {"type": "json_leaf", "names": "text"},
                         {"names": "object", "object": [{"type": "json_leaf", "names": "text"}, {"type": "json_leaf", "names": "text"}]},
                         {"type": "bool", "names": "bool"}]}},
    {"name": "j-order-a", "cluster": "j-order", "carrier": "json", "method": "POST", "path": ["orders"],
     "json": {"object": [{"names": "object", "array": [{"object": [{"type": "token", "names": "token"}, {"type": "int", "names": "int"}]}]},
                         {"type": "json_leaf", "names": "text"}, {"type": "json_leaf", "names": "text"}]}},
    {"name": "j-search-a", "cluster": "j-search", "carrier": "json", "method": "POST", "path": ["search", "advanced"],
     "json": {"object": [{"type": "json_leaf", "names": "text"},
                         {"names": "object", "object": [{"type": "enum", "names": "enum", "choices": ["en", "es", "pt"]}, {"type": "int", "names": "int"}]},
                         {"type": "int", "names": "int"}]}},
    {"name": "j-message-a", "cluster": "j-message", "carrier": "json", "method": "POST", "path": ["chat", "rooms", {"type": "int"}, "messages"],
     "json": {"object": [{"type": "json_leaf", "names": "text"}, {"type": "int", "names": "int"}]}},
    {"name": "j-webhook-a", "cluster": "j-webhook", "carrier": "json", "method": "PUT", "path": ["hooks", {"type": "token"}],
     "json": {"object": [{"type": "url", "names": "url"},
                         {"names": "object", "array": [{"type": "enum", "choices": ["created", "updated", "deleted"]},
                                                        {"type": "enum", "choices": ["created", "updated", "deleted"]}]},
                         {"type": "bool", "names": "bool"}]}},
    {"name": "j-document-a", "cluster": "j-document", "carrier": "json", "method": "POST", "path": ["documents", "render"],
     "json": {"object": [{"type": "path_file", "names": "path"}, {"type": "json_leaf", "names": "text"},
                         {"names": "object", "object": [{"type": "json_leaf", "names": "text"}]}]}},
    {"name": "j-review-a", "cluster": "j-review", "carrier": "json", "method": "POST", "path": ["products", {"type": "int"}, "reviews"],
     "json": {"object": [{"type": "int", "names": "int"}, {"type": "json_leaf", "names": "text"}, {"type": "json_leaf", "names": "text"},
                         {"names": "object", "object": [{"type": "json_leaf", "names": "text"}]}]}},
    {"name": "j-batch-a", "cluster": "j-batch", "carrier": "json", "method": "POST", "path": ["contacts", "batch"],
     "json": {"array": [{"object": [{"type": "json_leaf", "names": "text"}, {"type": "json_leaf", "names": "text"}]},
                        {"object": [{"type": "json_leaf", "names": "text"}, {"type": "json_leaf", "names": "text"}]}]}},

    {"name": "t-notes-a", "cluster": "t-notes", "carrier": "text", "method": "POST", "path": ["notes"],
     "text": {"type": "free_string"}},
    {"name": "t-feedback-a", "cluster": "t-feedback", "carrier": "text", "method": "POST", "path": ["feedback", {"type": "token"}],
     "text": {"type": "free_string"}},
    {"name": "t-paste-a", "cluster": "t-paste", "carrier": "text", "method": "PUT", "path": ["paste", {"type": "int"}, "raw"],
     "text": {"type": "free_string"}},
    {"name": "t-status-a", "cluster": "t-status", "carrier": "text", "method": "POST", "path": ["users", {"type": "int"}, "status"],
     "text": {"type": "free_string"}},
    {"name": "t-translate-a", "cluster": "t-translate", "carrier": "text", "method": "POST", "path": ["translate", "text"],
     "text": {"type": "free_string"}},
    {"name": "t-ticket-a", "cluster": "t-ticket", "carrier": "text", "method": "POST", "path": ["support", "tickets", {"type": "int"}, "reply"],
     "text": {"type": "free_string"}}
  ]
}
