{"nodes": [{"id": "firewall_ia_context_project_overview", "label": "firewall-IA Project", "file_type": "document", "source_file": "CONTEXT.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firewall_ia_context_tinyllama", "label": "TinyLlama-1.1B-Chat", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firewall_ia_context_lora_qlora", "label": "LoRA / QLoRA 4-bit Fine-tuning", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": "null", "contributor": null, "rationale": "4-bit NF4 quantization (rank=16, alpha=32) used to enable fine-tuning on a single consumer GPU (RTX 4090 Laptop) while keeping memory usage within 16 GB VRAM."}, {"id": "firewall_ia_context_parse_dataset", "label": "parse_dataset.py", "file_type": "code", "source_file": "CONTEXT.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firewall_ia_context_finetune", "label": "finetune.py", "file_type": "code", "source_file": "CONTEXT.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firewall_ia_context_test_model", "label": "test_model.py", "file_type": "code", "source_file": "CONTEXT.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firewall_ia_context_classifier_api", "label": "classifier_api.py (FastAPI Service)", "file_type": "code", "source_file": "CONTEXT.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firewall_ia_context_csic2010", "label": "CSIC 2010 HTTP Dataset", "file_type": "document", "source_file": "CONTEXT.md", "source_location": "\u00a73 Data Sources", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firewall_ia_context_payloads_all_the_things", "label": "PayloadsAllTheThings", "file_type": "document", "source_file": "CONTEXT.md", "source_location": "\u00a73 Data Sources", "source_url": "https://github.com/swisskyrepo/PayloadsAllTheThings", "captured_at": null, "author": "swisskyrepo", "contributor": null}, {"id": "firewall_ia_context_csic_database_csv", "label": "csic_database.csv", "file_type": "document", "source_file": "CONTEXT.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firewall_ia_context_dataset_v3_rebuild", "label": "Dataset v3-rebuild (99K)", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": "\u00a73 Dataset", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Previous v3 dataset (52K) was missing Path Traversal and CSRF due to renamed PayloadsAllTheThings folder names; fixing folder mappings added ~46K examples. Doubled size improves category coverage, especially CSRF which had 0 training examples before."}, {"id": "firewall_ia_context_model_v3_rebuild", "label": "Model v3-rebuild (Adapter)", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": "\u00a73 Model Versions", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firewall_ia_context_gguf_export", "label": "GGUF Export for llama.cpp", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GGUF format enables CPU/embedded inference via llama.cpp, targeting low-resource embedded Linux systems. HuggingFace Transformers inference is ~800ms which is the pre-optimization baseline."}, {"id": "firewall_ia_context_inline_proxy", "label": "Inline HTTP Proxy (Data Plane)", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firewall_ia_context_attack_categories", "label": "19 Attack Categories", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": "\u00a73 Attack Categories", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firewall_ia_context_huggingface_peft", "label": "HuggingFace PEFT", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firewall_ia_context_trl_sfttrainer", "label": "TRL SFTTrainer", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firewall_ia_context_python312_env", "label": "Python 3.12 ML Environment", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Post-reinstall, python3 maps to Python 3.14 which lacks the ML stack; all scripts must explicitly use python3.12 where torch, transformers, peft, trl, etc. are installed."}, {"id": "firewall_ia_context_proxy_data_factory", "label": "Proxy as Data Factory (Future Strategy)", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rather than generic benign-traffic datasets (which carry app/era bias like CSIC), capturing real traffic via a local proxy (e.g. DVWA/bWAPP + Burp Logger) ensures the same HTTP envelope for both ALLOW and BLOCK, breaking User-Agent/cookie shortcut bias."}, {"id": "firewall_ia_context_v4_plan", "label": "v4 Improvement Plan", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Incremental plan: Group 1 removes ###END### token (design cleanliness), Group 2 strengthens JWT/GraphQL weak categories, Group 3 fixes CSIC SQL bias via subsampling."}, {"id": "firewall_ia_context_csic_envelope_bias", "label": "CSIC Envelope Bias (Konqueror UA / JSESSIONID)", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All CSIC examples share the same Konqueror User-Agent and JSESSIONID cookie pattern, risking the model learning to detect attacks by envelope rather than payload content."}], "edges": [{"source": "firewall_ia_context_project_overview", "target": "firewall_ia_context_tinyllama", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTEXT.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "firewall_ia_context_project_overview", "target": "firewall_ia_context_lora_qlora", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTEXT.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "firewall_ia_context_project_overview", "target": "firewall_ia_context_inline_proxy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTEXT.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "firewall_ia_context_parse_dataset", "target": "firewall_ia_context_payloads_all_the_things", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTEXT.md", "source_location": "\u00a79", "weight": 1.0}, {"source": "firewall_ia_context_parse_dataset", "target": "firewall_ia_context_csic_database_csv", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTEXT.md", "source_location": "\u00a79", "weight": 1.0}, {"source": "firewall_i