# Model output directories
model-output*/

# HuggingFace cache
.cache/huggingface/

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Auto-generated dataset files (includes the historical root train.jsonl/eval.jsonl,
# which are not distributed; see docs/data_sources.md)
train.jsonl
eval.jsonl

# Third-party source data: kept locally for V4 regeneration, not redistributed
# (redistribution terms not confirmed). See docs/data_sources.md.
/csic_database.csv

# Virtual environments
venv/
.venv/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
# EXCEPT logs kept with an experiment record. A report's raw process logs ARE the
# evidence (docs/ml_evaluation_methodology.md section 13), so they must be durable in the
# repository, not machine-local. Without this negation the blanket *.log rule above
# silently excluded every process log of reports/diagnostics/real-http-fp-v1/ — the same
# failure mode that lost the 2026-09-17 raw data.
!reports/**/*.log

# Data plane environment (requirements-data-plane.txt)
.venv-dataplane/

# Analyzer research environment (requirements-analyzer-research.txt; D52 — never the data plane)
.venv-analyzer/

# Derived Analyzer dataset: regenerated locally from V4-clean like V4 itself (D6, D51);
# its manifest (datasets/manifest_hybrid_analyzer_v1.json) is tracked
datasets/hybrid_analyzer_v1/
datasets/hybrid_analyzer_v2/

# Docker Lab logs (destination receipt log, per-run output). The directory itself
# is tracked via .gitkeep so it exists after a clone: the destination container
# runs as a non-root user and cannot create it.
docker/.lab-logs/*
!docker/.lab-logs/.gitkeep

# V5 (spec r3 §8, D58): source pools, raw downloads and the future dataset are never committed.
datasets/v5_sources/
datasets/v5/

# Separately preserved V5 audit evidence
# PROPOSED .gitignore addition (NOT applied; content-free). Owner decision pending.
# Ignore rules do NOT remove already-staged/tracked files: run `git rm --cached` first
# (see reports/v5/data-readiness/first-pr-inventory.md, "Owner Git actions").
#
# V5 post-filter audit: raw third-party (PayloadsAllTheThings, MIT) payload text and the review records that
# reproduce it. Preserved outside Git; integrity + restoration in
# reports/v5/data-readiness/evidence-preservation-manifest.json
/reports/v5/postfilter-audit/round-1/sample.jsonl
/reports/v5/postfilter-audit/round-1/annotations_a?.jsonl
/reports/v5/postfilter-audit/round-1/adjudication_pending.jsonl
/reports/v5/postfilter-audit/round-1/adjudication_rule_applied.jsonl
/reports/v5/postfilter-audit/round-1/adjudication/
/reports/v5/postfilter-audit/round-1/human_review/*.csv
/reports/v5/postfilter-audit/round-1/**/discrepancy_sheet.jsonl
/reports/v5/postfilter-audit/round-1/**/annotations_a?.partial.jsonl
/reports/v5/postfilter-audit/round-1/**/packet.jsonl
/reports/v5/postfilter-audit/round-1/**/batches/
/reports/v5/postfilter-audit/round-1/**/*.handback.txt
/reports/v5/postfilter-audit/r3-review/reviewer/batch_*.jsonl
/reports/v5/data-readiness/xss_known_false_exclusions.md

# Pinned raw source snapshots remain local.
/reports/v5/data-readiness/names_family-candidate/wikidata_family_names.limit20000.json

# Disposable generated fixture trees; never audit or training evidence.
/reports/v5/.tmp-tests/

# Required historical SQLi source input, retained locally and in the recovery archive.
# Raw third-party source data is not published by this cleanup.
/reports/v5/postfilter-audit/sqli-v2-correction/sqli_corrected_pool.jsonl
