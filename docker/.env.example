# firewall-IA Docker Lab — environment template.
#
#   cp docker/.env.example .env
#
# The lab works with NO .env file: every variable below has a default in
# compose.yaml. Copy this only when a path or port on your machine differs.

# The V4 adapter on the host, mounted read-only into the control plane.
# It is gitignored and is NOT distributed by this repository: it must already
# exist locally. Default: ./model-output-v4-clean
#LAB_ADAPTER_DIR=./model-output-v4-clean

# The host HuggingFace hub cache, mounted read-only so the TinyLlama base model is
# reused instead of re-downloaded. Default: ${HOME}/.cache/huggingface/hub
#LAB_HF_HUB_CACHE=/home/youruser/.cache/huggingface/hub

# Where the destination writes its JSONL receipt log on the host.
# Default: ./docker/.lab-logs (gitignored)
#LAB_LOG_DIR=./docker/.lab-logs

# Owner of the files the destination writes. Set to your own `id -u`/`id -g` so the
# receipt log is not root-owned. Default: 1000:1000
#LAB_UID=1000
#LAB_GID=1000

# Host publication of the gateway. Loopback only by default; the lab needs no
# published port at all, this one exists so a human can drive the proxy by hand.
# Default: 127.0.0.1:8080
#LAB_PROXY_PUBLISH=127.0.0.1:8080
